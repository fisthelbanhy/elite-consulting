# À saisir dans les variables d'environnement Hostinger, pas dans le ZIP.
NODE_ENV=production
LF_ENVIRONNEMENT=prod
LF_SITE_URL=https://VOTRE-DOMAINE
LF_SERVIR_SITE=1
# Générer : node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
LF_COOKIE_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE

# EXEMPLES UNIQUEMENT : remplacer par des chemins persistants confirmés par Hostinger.
# Un chemin Linux absolu commence par / : il y a donc QUATRE / après sqlite:.
LF_DATABASE_URL=sqlite:////CHEMIN-PERSISTANT/data/lafrangine.sqlite3
LF_MEDIA_DIR=/CHEMIN-PERSISTANT/media

# Compléter pour l'envoi réel des e-mails.
LF_SMTP_HOST=
LF_SMTP_PORT=587
LF_SMTP_USER=
LF_SMTP_PASSWORD=
LF_SMTP_FROM=La Frangine <contact@VOTRE-DOMAINE>

# Ne pas fixer LF_PORT : le serveur utilise PORT fourni par Hostinger.
# Ne pas fixer BACKEND_URL : le serveur calcule son URL interne.
