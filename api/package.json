{
	"name": "lafrangine-api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "API Express/TypeScript de La Frangine — plateforme d'accompagnement des entrepreneurs congolais (ADR-0013)",
	"scripts": {
		"dev": "tsx watch src/serveur.ts",
		"start": "node dist/serveur.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "tsc --noEmit",
		"lint": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" && eslint src tests scripts",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
		"format:verifier": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
		"migration": "drizzle-kit generate",
		"migrer": "tsx src/scripts/migrer.ts",
		"donnees:demo": "tsx src/scripts/donnees-demo.ts",
		"verifier:schema": "tsx scripts/verifier-schema.ts",
		"verifier:routes": "tsx scripts/verifier-routes.ts",
		"verifier:reponses": "tsx scripts/comparer-reponses.ts",
		"build": "tsc -p tsconfig.build.json",
		"donnees:legacy": "tsx src/scripts/reprise-legacy.ts",
		"verifier:reprise": "tsx scripts/comparer-reprise.ts",
		"verifier:hachages": "tsx scripts/verifier-hachages.ts",
		"comptes:demo": "tsx src/scripts/comptes-demo.ts",
		"referentiels:exporter": "tsx src/scripts/exporter-referentiels.ts"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.2.1",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.3",
		"express": "^5.2.1",
		"multer": "^2.4.0",
		"nodemailer": "^10.0.11",
		"sharp": "^0.35.5",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/express": "^5.0.5",
		"@types/multer": "^2.0.0",
		"@types/node": "^22",
		"@types/nodemailer": "^7.0.4",
		"@types/supertest": "^6.0.3",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.5.0",
		"prettier": "^3.8.3",
		"supertest": "^7.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^5.0.2"
	}
}
